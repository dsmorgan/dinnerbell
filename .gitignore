# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local config and data. .env and .env.test hold secrets; only the examples are committed.
.env
.env.*
!.env.example
!.env.test.example
migrations-scratch.db
/data/
*.db
*.db-wal
*.db-shm

# Household-specific files that must never be committed: your compose override, local
# copies of templates (such as a Slack manifest with your hostname), and your catalog.
compose.override.yaml
*.local.yaml
/seed/*
!/seed/example.yaml
!/seed/catalog.schema.json

# Editors and OS
.vscode/
.idea/
.DS_Store

# Dinnerbell test instance configuration (ADR 0006). Copy to .env.test, fill in the blanks, and
# keep .env.test out of version control. deploy/dinnerbell-test reads it.
# .env.example explains every variable. Nothing here may be shared with production: use the
# test Slack app's tokens and client, its own secret key, and its own hostname.
# To keep the four secrets in files instead, create all four in secrets-test/ and leave their
# lines here empty: deploy/dinnerbell-test then mounts them. See "Keep secrets in files" in
# docs/setup.md.

# --- Test instance --------------------------------------------------------------------------

# Shows a TEST marker on the web, in Slack posts, on App Home, and in /healthz. While it's set,
# Dinnerbell mentions and messages only members of DINNERBELL_SLACK_CHANNEL, and
# `dinnerbell scrub-test` is allowed to run. deploy/dinnerbell-test refuses to start without it.
DINNERBELL_INSTANCE_LABEL=TEST

# Must match the command in deploy/slack-app-manifest.test.yaml.
DINNERBELL_SLACK_COMMAND=/dinnerbell-test

# Comma-separated feature flags to turn on. Unknown names stop startup.
DINNERBELL_FEATURES=

# --- Required -------------------------------------------------------------------------------

# The test hostname, behind Pangolin authentication. Never production's URL.
DINNERBELL_BASE_URL=https://dinnerbell-test.example.com

# Generate a new key; never reuse production's:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DINNERBELL_SECRET_KEY=

DINNERBELL_ADMIN_EMAIL=

# The Dinnerbell Test app's client ID and secret, not production's.
DINNERBELL_OIDC_ISSUER=https://slack.com
DINNERBELL_OIDC_CLIENT_ID=
DINNERBELL_OIDC_CLIENT_SECRET=

# --- Optional -------------------------------------------------------------------------------

DINNERBELL_DATABASE_URL=sqlite:////data/dinnerbell.db
DINNERBELL_HOUSEHOLD_NAME=Test
DINNERBELL_OIDC_SCOPES=openid email profile

# Same workspace as production.
DINNERBELL_SLACK_TEAM_ID=

# The Dinnerbell Test app's tokens. Never production's: Socket Mode delivers each event to one
# connection, so shared tokens split button taps between the two instances.
DINNERBELL_SLACK_BOT_TOKEN=
DINNERBELL_SLACK_APP_TOKEN=

# The test channel, such as #dinnerbell-test. Invite the Dinnerbell Test bot to it. Only its
# members get mentions and direct messages.
DINNERBELL_SLACK_CHANNEL=

DINNERBELL_TIMEZONE=America/New_York
DINNERBELL_SEED_FILE=
DINNERBELL_LOG_LEVEL=INFO
DINNERBELL_TRUSTED_PROXIES=

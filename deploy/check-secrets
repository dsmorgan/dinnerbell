#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Check Dinnerbell's four secret files before you start the service, without reading or printing
# any value:
#   deploy/check-secrets            production's, in secrets/
#   deploy/check-secrets secrets-test
#   deploy/check-secrets --env-file .env      also compare each file with its line in .env
# Each must exist as a file (or a link to one), have mode 600 (400 is fine), and not be empty. The
# two Slack tokens may be empty when you don't use Slack. It doesn't check the owner, which must be
# the container's user (UID 10001; `podman unshare ls -ln secrets` shows it with rootless podman).
# Exit status 1 means at least one problem.
#
# With --env-file, it also prints match or differs for each secret, comparing SHA-256 hashes of the
# file and of the value on the last DINNERBELL_<NAME>= line of the env file (one pair of enclosing
# quotes removed). Use it after you copy secrets out of .env and before you delete them there. It
# needs to read the files, so run it before you give them to the container's user.
set -eu

CDPATH='' cd -- "$(dirname -- "$0")/.."
env_file=
if [ "${1:-}" = --env-file ]; then
    [ -n "${2:-}" ] || { echo "check-secrets: --env-file needs a file name." >&2; exit 2; }
    env_file=$2
    shift 2
fi
dir=${1:-secrets}
problems=0

# The value an env file gives $1: the last assignment, without "export ", carriage returns, or one
# pair of enclosing quotes. A trailing comment or an escape inside quotes isn't handled.
env_value() {
    sed -n "s/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}$1[[:space:]]*=[[:space:]]*//p" "$env_file" |
        tail -n 1 | tr -d '\r' | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}

# The SHA-256 of stdin without whitespace, as the app reads a secret.
digest() {
    tr -d ' \t\r\n' | { sha256sum 2>/dev/null || shasum -a 256; } | awk '{ print $1 }'
}

compare() {
    if [ ! -r "$2" ]; then
        echo "check-secrets: $1: can't read $2 to compare (run this before you chown the files)." >&2
        problems=$((problems + 1))
    elif [ "$(env_value "$1" | digest)" = "$(digest <"$2")" ]; then
        echo "$1: match"
    else
        echo "$1: differs"
        problems=$((problems + 1))
    fi
}

# The octal mode of file $1: GNU stat, then BSD stat.
mode_of() {
    stat -Lc %a -- "$1" 2>/dev/null || stat -Lf %Lp -- "$1"
}

for name in DINNERBELL_SECRET_KEY DINNERBELL_OIDC_CLIENT_SECRET DINNERBELL_SLACK_BOT_TOKEN DINNERBELL_SLACK_APP_TOKEN; do
    file="$dir/$name"
    if [ -d "$file" ]; then
        echo "check-secrets: $file is a directory. Remove it and create the file." >&2
        problems=$((problems + 1))
    elif [ ! -e "$file" ]; then
        echo "check-secrets: $file is missing. See \"Keep secrets in files\" in docs/setup.md." >&2
        problems=$((problems + 1))
    elif [ ! -f "$file" ]; then
        echo "check-secrets: $file is not a regular file." >&2
        problems=$((problems + 1))
    else
        mode=$(mode_of "$file")
        case "$mode" in
            600 | 400) ;;
            *)
                echo "check-secrets: $file has mode $mode, not 600. Run: chmod 600 $file" >&2
                problems=$((problems + 1))
                ;;
        esac
        if [ ! -s "$file" ]; then
            case "$name" in
                *SLACK*) echo "check-secrets: $file is empty, so Slack is off." >&2 ;;
                *)
                    echo "check-secrets: $file is empty." >&2
                    problems=$((problems + 1))
                    ;;
            esac
        fi
    fi
done

if [ -n "$env_file" ]; then
    [ -r "$env_file" ] || { echo "check-secrets: can't read $env_file." >&2; exit 1; }
    for name in DINNERBELL_SECRET_KEY DINNERBELL_OIDC_CLIENT_SECRET DINNERBELL_SLACK_BOT_TOKEN DINNERBELL_SLACK_APP_TOKEN; do
        [ -f "$dir/$name" ] && compare "$name" "$dir/$name"
    done
fi

[ "$problems" -eq 0 ] || exit 1
echo "check-secrets: the four files in $dir/ look right."

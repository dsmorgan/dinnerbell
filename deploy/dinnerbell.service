# Optional: start production at boot on a rootless podman host. Docker doesn't need this unit:
# its daemon restarts the container after a reboot, because compose.yaml sets
# restart: unless-stopped. Install it as in "Start at boot" in docs/setup.md:
#   loginctl enable-linger "$USER"
#   mkdir -p ~/.config/systemd/user && cp deploy/dinnerbell.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now dinnerbell.service
#
# Change nothing here; `systemctl --user edit dinnerbell.service` keeps your changes in a drop-in
# that survives copying a newer version of this file. For example:
#   [Service]
#   WorkingDirectory=/srv/dinnerbell
#   ExecStart=
#   ExecStart=/usr/bin/env podman-compose -f compose.yaml -f compose.secrets.yaml up -d
[Unit]
Description=Dinnerbell
Documentation=https://github.com/dsmorgan/dinnerbell/blob/main/docs/setup.md#start-at-boot
# A user manager has no network-online.target of its own, so this line orders nothing there;
# ExecStartPre waits for the system's instead.
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The directory that holds compose.yaml and .env. Compose names the data volume after it.
WorkingDirectory=%h/dinnerbell
# A user unit's PATH leaves out ~/.local/bin, where pip installs podman-compose. systemd looks up a
# bare command name on its own built-in path, not this one, so commands go through /usr/bin/env.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# While the system's network-online.target has a start job pending, wait for it, for up to two
# minutes; then start anyway. A host where nothing wants that target never queues it, so there's
# nothing to wait for. The default DINNERBELL_BIND, 127.0.0.1, needs no network, and Dinnerbell
# reconnects to Slack on its own; a LAN address in DINNERBELL_BIND needs the network up.
ExecStartPre=-/usr/bin/timeout 120 /bin/sh -c 'while systemctl list-jobs --no-legend network-online.target | grep -q .; do sleep 1; done'
ExecStart=/usr/bin/env podman-compose up -d
ExecStop=/usr/bin/env podman-compose down
# Room to pull the image when it isn't on the host.
TimeoutStartSec=10min

[Install]
WantedBy=default.target

#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Run compose for the Dinnerbell test instance (ADR 0006). Pass any compose subcommand:
#   deploy/dinnerbell-test pull
#   deploy/dinnerbell-test up -d
#   deploy/dinnerbell-test run --rm dinnerbell scrub-test --keep you@example.com
#   deploy/dinnerbell-test down
#   DINNERBELL_TAG=X.Y.Z deploy/dinnerbell-test up -d     # rehearse a release
#
# Always use this script for test, never podman-compose directly. It sets everything that
# separates test from production in one place: the project name, the volume
# (dinnerbell-test_dinnerbell-data, named in deploy/compose.test.yaml), the env file, the image
# tag, and the port. Compose reads ${...} values in compose.yaml from the shell and from .env,
# which belongs to production, so the test values are set in the shell. podman-compose 1.1.0 and
# older let .env win over the shell, so this script refuses to run if .env sets any of them.
# Test publishes on production's DINNERBELL_BIND, read from .env.
#
# Before any command that may start a container (all but down, stop, logs, and the like), it
# refuses an env file that shares a secret with .env, and runs `dinnerbell config check` on the
# env file in a one-off container of the same image, with no network, volume, or published port,
# so a missing setting shows up here instead of as a restart loop.
#
# Overrides: DINNERBELL_TAG (default main), DINNERBELL_ENV_FILE (default .env.test),
# DINNERBELL_PORT (default 8014), DINNERBELL_COMPOSE (default podman-compose; for Docker use
# DINNERBELL_COMPOSE="docker compose"), DINNERBELL_ENGINE (the container engine for the check:
# docker when DINNERBELL_COMPOSE starts with docker, else podman). Set them per command; never
# export them.
set -eu

PROJECT=dinnerbell-test
VOLUME=dinnerbell-test_dinnerbell-data
# The image in compose.yaml, without its tag. scripts/check-compose.sh checks that they match.
IMAGE=ghcr.io/dsmorgan/dinnerbell
# Settings that must differ between test and production.
SECRETS="DINNERBELL_SECRET_KEY DINNERBELL_SLACK_BOT_TOKEN DINNERBELL_SLACK_APP_TOKEN DINNERBELL_OIDC_CLIENT_SECRET"

fail() {
    echo "dinnerbell-test: $*" >&2
    exit 1
}

# Lines in an env file that assign $2, in compose's dotenv syntax (optional "export ").
assignments() {
    grep -E "^[[:space:]]*(export[[:space:]]+)?$2[[:space:]]*=" "$1" || true
}

# An awk program that reads env files as python-dotenv 1.2 reads them for podman-compose, and
# keeps the last value each file gives the variable `name`: "export ", spaces around "=", and a
# byte-order mark are ignored. A quoted value ends at the first quote that no backslash escapes,
# and only spaces or a comment may follow it; then its backslash escapes are decoded. An unquoted
# value ends before a "#" that follows a space. A line it can't parse is skipped; values that span
# lines and ${...} aren't supported. With anycase=yes, the name matches in any case, as
# pydantic-settings reads it. With mode=print, it prints the value from its one file. Otherwise
# it takes production's file, then test's, and exits 0 when both give the same non-empty value,
# 3 when a line of test's file contains production's value (16 bytes or longer) anywhere, which
# catches what the parser misses, such as a commented-out copy or ${...}, and 1 when neither
# holds; secrets never leave awk. Run it with LC_ALL=C so every awk counts bytes, and with "./"
# before a relative file name, so a name with "=" in it isn't read as an assignment.
# shellcheck disable=SC2016 # awk's own $0, not the shell's.
DOTENV_AWK='
    function unescape(s, q,    out, j, c, d, e) {
        out = ""
        for (j = 1; j <= length(s); j++) {
            c = substr(s, j, 1)
            d = substr(s, j + 1, 1)
            if (c == "\\" && d != "" &&
                (q == "\047" ? index("\\\047", d) : index("\\\"\047abfnrtv", d))) {
                e = index("abfnrtv", d)
                if (q == "\"" && e) d = substr("\a\b\f\n\r\t\v", e, 1)
                out = out d
                j++
            } else {
                out = out c
            }
        }
        return out
    }
    { n = (ARGC > 2 && FILENAME == ARGV[2]) ? 2 : 1 }
    n == 2 && length(found[1]) >= 16 && index($0, found[1]) { leaked = 1 }
    FNR == 1 && substr($0, 1, 3) == "\357\273\277" { $0 = substr($0, 4) }
    {
        line = $0
        sub(/\r$/, "", line)
        if (!match(line, /^[ \t]*(export[ \t]+)?[^=# \t]+[ \t]*=/)) next
        key = substr(line, 1, RLENGTH)
        rest = substr(line, RLENGTH + 1)
        sub(/^[ \t]*(export[ \t]+)?/, "", key)
        sub(/[ \t]*=$/, "", key)
        if (anycase == "yes") { if (toupper(key) != toupper(name)) next } else if (key != name) next
        spaced = rest ~ /^[ \t]/
        sub(/^[ \t]*/, "", rest)
        q = substr(rest, 1, 1)
        if (q != "\"" && q != "\047") {
            # "NAME= # comment" is empty, and "NAME=#value" is "#value".
            if (spaced && q == "#") rest = ""
            sub(/[ \t]+#.*$/, "", rest)
            sub(/[ \t]+$/, "", rest)
            found[n] = rest
            next
        }
        close_at = 0
        for (i = 2; i <= length(rest); i++) {
            c = substr(rest, i, 1)
            if (c == "\\") i++
            else if (c == q) { close_at = i; break }
        }
        if (!close_at || substr(rest, close_at + 1) !~ /^[ \t]*(#.*)?$/) next
        found[n] = unescape(substr(rest, 2, close_at - 2), q)
    }
    END {
        if (mode == "print") printf "%s", found[1]
        else if (found[1] != "" && found[1] == found[2]) exit 0
        else if (leaked) exit 3
        else exit 1
    }
'

# The value an env file gives $2. Never use it for a secret; compare those with `shares`.
value() {
    LC_ALL=C awk -v name="$2" -v mode=print "$DOTENV_AWK" "$(operand "$1")"
}

# Whether test's env file $2 shares production's ($1) value of variable $3, in any case: exit 0
# for the same value, 3 for production's value inside a line, 1 for neither, anything else for
# an error.
shares() {
    LC_ALL=C awk -v name="$3" -v anycase=yes "$DOTENV_AWK" "$(operand "$1")" "$(operand "$2")"
}

# A file name awk reads as a file: "./" before a relative one.
operand() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        *) printf './%s' "$1" ;;
    esac
}

# A file's inode number, following symlinks, to tell whether two paths are the same file.
# Only the first field is read, so odd file names can't confuse it.
inode() {
    # shellcheck disable=SC2012
    ls -iLd -- "$1" | awk '{ print $1 }'
}

# Compose project names are lowercase letters, digits, "-" and "_".
normalize() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_-'
}

[ ! -L "$0" ] || fail "run the script from your clone (deploy/dinnerbell-test), not through a symlink."
CDPATH='' cd -- "$(dirname -- "$0")/.."
if [ ! -f compose.yaml ] || [ ! -f deploy/compose.test.yaml ]; then
    fail "can't find compose.yaml and deploy/compose.test.yaml next to this script."
fi

# Global options such as -p or -f would undo the separation this script sets up.
case "${1:-}" in
    -*) fail "put compose options after the subcommand, for example: deploy/dinnerbell-test up -d" ;;
esac

DINNERBELL_TAG="${DINNERBELL_TAG:-main}"
DINNERBELL_ENV_FILE="${DINNERBELL_ENV_FILE:-.env.test}"
DINNERBELL_PORT="${DINNERBELL_PORT:-8014}"
export DINNERBELL_TAG DINNERBELL_ENV_FILE DINNERBELL_PORT

[ -f "$DINNERBELL_ENV_FILE" ] ||
    fail "$DINNERBELL_ENV_FILE not found. Copy .env.test.example to .env.test and fill it in."
# Every check below reads both files; one it can't read would pass silently.
[ -r "$DINNERBELL_ENV_FILE" ] || fail "can't read $DINNERBELL_ENV_FILE. Run this script as the user who owns it."
[ ! -e .env ] || [ -r .env ] || fail "can't read .env. Run this script as the user who owns it."
if [ -e .env ] && [ "$(inode "$DINNERBELL_ENV_FILE")" = "$(inode .env)" ]; then
    fail "refusing to use production's .env. Test needs its own env file, Slack app, and secret key."
fi

# Without a label, test looks like production, can notify anyone in the workspace, and
# scrub-test refuses to run. Compose uses the last assignment, so allow exactly one.
label=$(assignments "$DINNERBELL_ENV_FILE" DINNERBELL_INSTANCE_LABEL)
[ "$(printf '%s' "$label" | grep -c .)" -le 1 ] ||
    fail "$DINNERBELL_ENV_FILE sets DINNERBELL_INSTANCE_LABEL more than once. Keep one line."
printf '%s\n' "$label" | grep -Eq "=[[:space:]]*[\"']?[A-Za-z0-9]" ||
    fail "set DINNERBELL_INSTANCE_LABEL in $DINNERBELL_ENV_FILE, for example TEST."

if [ -f .env ]; then
    for name in DINNERBELL_TAG DINNERBELL_ENV_FILE DINNERBELL_PORT; do
        [ -z "$(assignments .env "$name")" ] ||
            fail ".env sets $name. Remove it: older podman-compose versions would apply it to test too."
    done
fi

# Production's project name is COMPOSE_PROJECT_NAME from the shell or .env, or else the clone's
# directory name. If it were dinnerbell-test, both instances would share containers.
production="${COMPOSE_PROJECT_NAME:-}"
if [ -z "$production" ] && [ -f .env ]; then
    production=$(value .env COMPOSE_PROJECT_NAME)
fi
[ -n "$production" ] || production=$(basename "$PWD")
[ "$(normalize "$production")" != "$PROJECT" ] ||
    fail "production's compose project is also named $PROJECT. Rename the clone's directory (for example to dinnerbell) or change COMPOSE_PROJECT_NAME."

# Every command gets the pre-flight checks below, except those known not to start a container,
# which run even when the env file is broken, so you can always stop and inspect test.
case "${1:-}" in
    down | stop | kill | rm | logs | ps | pull | config | images | top | port | pause | unpause | exec | version)
        starts=no ;;
    *) starts=yes ;;
esac

# Shared tokens split Slack events between the instances; a shared secret key lets one instance's
# cookies and CSRF tokens work on the other. awk compares the values itself, so they never reach
# the shell, a command line, or a message. An error counts as shared.
if [ "$starts" = yes ] && [ -f .env ]; then
    for name in $SECRETS; do
        status=0
        shares .env "$DINNERBELL_ENV_FILE" "$name" || status=$?
        case "$status" in
            0) fail "$DINNERBELL_ENV_FILE and .env have the same $name. Give test its own: see \"Write .env.test\" in docs/setup.md." ;;
            1) ;;
            3) fail "$DINNERBELL_ENV_FILE contains production's $name from .env, in a comment or another line. Remove it." ;;
            *) fail "can't compare $name in $DINNERBELL_ENV_FILE and .env (awk exit $status). Nothing was started." ;;
        esac
    done
fi

echo "dinnerbell-test: project $PROJECT, volume $VOLUME, env file $DINNERBELL_ENV_FILE, image tag $DINNERBELL_TAG, port $DINNERBELL_PORT" >&2

if [ "$starts" = yes ]; then
    case "${DINNERBELL_COMPOSE:-podman-compose}" in
        docker*) engine="${DINNERBELL_ENGINE:-docker}" ;;
        *) engine="${DINNERBELL_ENGINE:-podman}" ;;
    esac
    image="$IMAGE:$DINNERBELL_TAG"
    if ! "$engine" image inspect "$image" >/dev/null 2>&1; then
        echo "dinnerbell-test: pulling $image to check $DINNERBELL_ENV_FILE" >&2
        "$engine" pull "$image" >&2 || fail "can't pull $image. Check DINNERBELL_TAG and the network. Nothing was started."
    fi
    # The same image and env file the service gets, with nothing it could reach or change. The env
    # file goes in on stdin, and the app parses it with python-dotenv, as podman-compose 1.2.0 and
    # later do (docker compose's parser agrees on quotes, "export ", and comments). podman's own
    # --env-file would keep quotes, and quotes a line it can't parse, value and all. The image
    # declares /data a volume, so the engine adds an empty anonymous one, and --rm deletes it.
    # The output names settings and line numbers, never values; --log-driver none keeps even that
    # out of the journal.
    status=0
    problems=$("$engine" run -i --rm --pull=never --log-driver none --network none --read-only \
        --cap-drop ALL --security-opt no-new-privileges "$image" config check --env-file - \
        <"$DINNERBELL_ENV_FILE" 2>&1 >/dev/null) || status=$?
    if [ "$status" -eq 2 ] &&
        printf '%s\n' "$problems" | grep -q "^dinnerbell: error: argument COMMAND: invalid choice: 'config'"; then
        echo "dinnerbell-test: $image predates dinnerbell config check; starting without it." >&2
    elif [ "$status" -eq 0 ]; then
        # Warnings, such as a line python-dotenv can't parse.
        [ -z "$problems" ] || printf '%s\n' "$problems" >&2
    else
        printf '%s\n' "$problems" >&2
        [ "$status" -eq 2 ] ||
            fail "couldn't run the configuration check in $image (exit $status). Nothing was started."
        fail "fix the settings above in $DINNERBELL_ENV_FILE, then run the command again. Nothing was started."
    fi
fi

# DINNERBELL_COMPOSE may hold two words ("docker compose"), so it's split on purpose.
# shellcheck disable=SC2086
exec ${DINNERBELL_COMPOSE:-podman-compose} -p "$PROJECT" -f compose.yaml -f deploy/compose.test.yaml "$@"

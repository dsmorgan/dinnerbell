# Dinnerbell configuration. Copy to .env, fill in the blanks, and keep .env out of version control.
# Empty values count as unset. Every variable can also come from a file in /run/secrets named
# after the variable (for example /run/secrets/DINNERBELL_SECRET_KEY) for podman or docker secrets.

# --- Required -------------------------------------------------------------------------------

# Public URL people open, exactly as Pangolin exposes it. Must be https (http is allowed only for
# localhost or 127.0.0.1 during local testing). No path: serve Dinnerbell at the root of its host.
DINNERBELL_BASE_URL=https://dinner.example.com

# Signing key for cookies and CSRF tokens, at least 32 characters. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it signs everyone out of in-progress sign-ins and invalidates open forms.
DINNERBELL_SECRET_KEY=

# The first admin. Created as an invited admin on first start if no member has this email.
# Sign in with an account whose verified email matches it.
DINNERBELL_ADMIN_EMAIL=

# OpenID Connect provider. The issuer must publish /.well-known/openid-configuration.
# For Sign in with Slack use https://slack.com and the Slack app's client ID and secret.
# Register this redirect URL with the provider: <DINNERBELL_BASE_URL>/auth/callback
DINNERBELL_OIDC_ISSUER=https://slack.com
DINNERBELL_OIDC_CLIENT_ID=
DINNERBELL_OIDC_CLIENT_SECRET=

# --- Optional -------------------------------------------------------------------------------

# SQLite database location. Keep it under /data, the container's only writable volume.
# Backups go to a backups/ directory next to the database file.
DINNERBELL_DATABASE_URL=sqlite:////data/dinnerbell.db

# Household name shown in the app. Used only when the household is first created.
DINNERBELL_HOUSEHOLD_NAME=Home

# Scopes requested at sign-in. Must include openid and email.
DINNERBELL_OIDC_SCOPES=openid email profile

# Slack workspace (team) ID, such as T0123ABCD. Required when DINNERBELL_OIDC_ISSUER is
# https://slack.com: Dinnerbell refuses to start without it. Sign-in goes straight to this
# workspace, and anyone signing in from another workspace is refused. Leave empty with other
# providers.
DINNERBELL_SLACK_TEAM_ID=

# Slack bot token (starts with xoxb-) and Socket Mode app-level token (starts with xapp-).
# Not used until milestone M2; leave empty for now. Validated if set.
DINNERBELL_SLACK_BOT_TOKEN=
DINNERBELL_SLACK_APP_TOKEN=

# Slack channel ID for household posts, such as C0123ABCD. Not used until milestone M2.
DINNERBELL_SLACK_CHANNEL=

# Household time zone (IANA name). Sets when the nightly backup runs (03:30 local) and,
# from M2, when calls go out. Default: UTC.
DINNERBELL_TIMEZONE=America/Chicago

# Catalog file to import on first start. Not used until milestone M1.
DINNERBELL_SEED_FILE=

# DEBUG, INFO, WARNING, or ERROR. Default: INFO. At DEBUG, each request logs the direct peer
# address and the resolved client address, which helps you find your proxy's address for
# DINNERBELL_TRUSTED_PROXIES.
DINNERBELL_LOG_LEVEL=INFO

# Reverse proxies allowed to set X-Forwarded-For, as comma-separated IPs or CIDR ranges.
# Default: trust none, so the rate limiter sees the proxy's address for every request.
# Behind Pangolin, set this to the address Newt (or Gerbil) connects from, as seen by the
# container. Find it by running with DINNERBELL_LOG_LEVEL=DEBUG and reading "peer_ip".
# Example: DINNERBELL_TRUSTED_PROXIES=10.89.0.0/24
DINNERBELL_TRUSTED_PROXIES=
